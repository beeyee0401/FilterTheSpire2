<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\Sts2PathDiscovery.props"/>
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <OutputType>Exe</OutputType>
        <PlatformTarget>x64</PlatformTarget>
        <Prefer32Bit>false</Prefer32Bit>
    </PropertyGroup>

    <!--  Ignore the ModAnalyzer warning  -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);STS002</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\FilterTheSpire2\FilterTheSpire2.csproj"
                          ExcludeAssets="analyzers;build;buildtransitive" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="MSTest" Version="4.0.2"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

</Project>
